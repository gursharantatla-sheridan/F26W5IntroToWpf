<Window x:Class="F26W5IntroToWpf.TabControlExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F26W5IntroToWpf"
        mc:Ignorable="d"
        Title="TabControlExample" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Personal Info">
                <Canvas>
                    <Label Content="Label" Canvas.Left="37" Canvas.Top="48"/>
                    <Label Content="Label" Canvas.Left="37" Canvas.Top="99"/>
                    <TextBox Canvas.Left="80" TextWrapping="Wrap" Text="TextBox" Canvas.Top="52" Width="120"/>
                    <TextBox Canvas.Left="80" TextWrapping="Wrap" Text="TextBox" Canvas.Top="103" Width="120"/>
                    <Button Content="Button" Canvas.Left="160" Canvas.Top="151"/>
                </Canvas>
            </TabItem>

            <TabItem Header="Hobbies">
                <StackPanel>
                    <CheckBox Content="CheckBox"/>
                    <CheckBox Content="CheckBox"/>
                    <CheckBox Content="CheckBox"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
